[Unit]
Description=Heal the DefenseClaw OpenClaw plugin extension if a sidecar restart corrupts it

[Service]
Type=oneshot
Environment=CLAWLAB_REPO=%h/clawlab
ExecStart=/bin/bash -lc 'source "${CLAWLAB_REPO:-$HOME/clawlab}/admin-access/lib/ensure-openclaw-extensions.sh" && ensure_defenseclaw_openclaw_extension && systemctl --user try-restart openclaw-gateway.service'
