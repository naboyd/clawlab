# ---- local scratch ----
.tmp/

# ---- secrets: never commit ----
*.env
.env
!*.env.example
master.key
*.key
*.pem
*.crt
*.pfx
godaddy.env
data/            # ssh-ops runtime secrets store + hosts.yaml
**/data/.env
hosts.yaml       # real host inventory (use hosts.example.yaml)
gateway.systemd.env

# ---- runtime state / logs / dbs ----
*.log
logs/
*.db
*.db-shm
*.db-wal
audit.db*
__pycache__/
*.pyc
*.bak
*.bak.*
.DS_Store

# Large vendor PDFs (optional; maintainer fetch script lives in _archive/)
docs/reference/*.pdf

# Local maintainer archive (not shipped to beta testers)
# Run: bash admin-access/populate-maintainer-archive.sh
_archive/*
!_archive/README.md
!_archive/MANIFEST.txt

# ---- local certs / lego ----
acme/lego/
certificates/
