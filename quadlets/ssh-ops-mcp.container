# systemd Quadlet — ssh-ops MCP (streamable-http on :8766, internal upstream).
#
# Do NOT edit ~/.config/containers/systemd/ssh-ops-mcp.container by hand.
# Install/render from portal config:
#   bash admin-access/install-ssh-ops-mcp-quadlet.sh
#
# Clients use the identity proxy on :8767, not raw :8766.
# Placeholders @MCP_PUBLISH@, @SSH_OPS_DATA_REL@, @MCP_TLS_LINES@ are
# substituted by the install script from ~/.claw-portals/config.env.

[Unit]
Description=ssh-ops MCP server (streamable-http)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/ssh-ops:latest
Exec=mcp
Environment=SSH_OPS_MCP_TRANSPORT=streamable-http
Environment=SSH_OPS_MCP_PORT=8766
PublishPort=@MCP_PUBLISH@
Volume=%h/@SSH_OPS_DATA_REL@:/data:Z
Volume=%h/.ssh:/root/.ssh:ro,Z
Volume=%h/.claw-auth/users.db:/claw-auth/users.db:ro,Z
Volume=%h/.defenseclaw:/defenseclaw:ro,Z
EnvironmentFile=%h/.claw-portals/config.env
Environment=CLAW_AUTH_DB=/claw-auth/users.db
Environment=DEFENSECLAW_HOME=/defenseclaw
Environment=SSH_OPS_RBAC=1
@MCP_TLS_LINES@

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
