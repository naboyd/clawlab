[Unit]
Description=ssh-ops MCP server (streamable-http)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/ssh-ops:latest
Exec=mcp
Environment=SSH_OPS_MCP_TRANSPORT=streamable-http
Environment=SSH_OPS_MCP_PORT=8766
PublishPort=192.168.1.10:8766:8766
Volume=%h/ssh_ops_mcp/data:/data:Z
Volume=%h/.ssh:/root/.ssh:ro,Z
Volume=%h/.claw-auth/users.db:/claw-auth/users.db:ro,Z
Environment=CLAW_AUTH_DB=/claw-auth/users.db
Environment=SSH_OPS_RBAC=1

Volume=%h/mcp/acme/lego/certificates:/certs:ro,Z
Environment=SSH_OPS_MCP_TLS_CERT=/certs/lab.example.com.crt
Environment=SSH_OPS_MCP_TLS_KEY=/certs/lab.example.com.key

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
