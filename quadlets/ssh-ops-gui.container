# systemd Quadlet unit — runs the ssh-ops config GUI as a rootless service.
#
# Install (rootless):
#   mkdir -p ~/.config/containers/systemd
#   cp ssh-ops-gui.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start ssh-ops-gui
#   loginctl enable-linger "$USER"
#
# Build the image first:  podman build -t ssh-ops:latest ~/clawlab/ssh-ops-mcp
#
# LAN access: use nginx + claw-auth on port 8443 (install-portals.sh).
# Do NOT publish 8765 beyond loopback. CLAW_AUTH_REQUIRED=1 rejects direct access.

[Unit]
Description=ssh-ops config GUI
After=network-online.target claw-auth.service
Wants=network-online.target

[Container]
Image=localhost/ssh-ops:latest
Exec=gui
# Loopback only — nginx on :8443 is the LAN entry with claw-auth.
PublishPort=127.0.0.1:8765:8765
Volume=%h/ssh_ops_mcp/data:/data:Z
Volume=%h/.ssh:/root/.ssh:ro,Z
EnvironmentFile=%h/.claw-portals/config.env
Environment=CLAW_AUTH_REQUIRED=1
Environment=PORTAL_MOUNT_PATH=/ssh-ops

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
