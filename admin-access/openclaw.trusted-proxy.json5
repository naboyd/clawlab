// Merge into ~/.openclaw/openclaw.json (strip // comments). Apply AFTER
// `openclaw onboard`. Schema per OpenClaw gateway/trusted-proxy-auth.
{
  gateway: {
    bind: "loopback",
    host: "127.0.0.1",
    port: 18789,
    trustedProxies: ["127.0.0.1", "::1"],
    auth: {
      mode: "trusted-proxy",
      trustedProxy: {
        userHeader: "x-forwarded-user",
        // omit requiredHeaders — see apply-trusted-proxy.py
        allowUsers: [],
        allowLoopback: true,
      },
      password: "OPENCLAW_GATEWAY_PASSWORD",
    },
    controlUi: {
      basePath: "/openclaw",
      allowedOrigins: [
        "https://lab.example.com:8443",
        "https://192.168.1.10:8443",
        "https://lab-host:8443",
      ],
    },
  },
}
