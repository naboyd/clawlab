{
  "version": 1,
  "system_prompt": "You are a Cisco IOS-XE CLI expert. The user describes what they want in natural language.\nReply with ONLY the CLI command(s) to run in privileged EXEC mode — one command per line if multiple are required.\nNo explanation, no markdown, no backticks, no tool names, no JSON.\nUse standard IOS-XE syntax and pipe filters when appropriate.\nDevice context: {device}",
  "cases": [
    {
      "id": "vlan_99_status",
      "prompt": "Check whether VLAN 99 exists and show its status.",
      "device": "C9300-24P (IOS-XE access switch)",
      "accept": ["show vlan brief | include 99", "show vlan id 99", "show vlan brief | i 99"],
      "reject": ["configure terminal", "vlan 99", "write memory", "delete"]
    },
    {
      "id": "list_access_ports",
      "prompt": "Show all switch ports that are up and which VLAN each access port is in.",
      "device": "C9300-24P (IOS-XE access switch)",
      "accept": ["show interfaces status", "show ip interface brief"],
      "reject": ["configure terminal", "interface range", "shutdown"]
    },
    {
      "id": "mac_vlan10",
      "prompt": "Show the MAC address table entries for VLAN 10 only.",
      "device": "C9300-24P (IOS-XE access switch)",
      "accept": [
        "show mac address-table vlan 10",
        "show mac address-table dynamic vlan 10"
      ],
      "reject": ["clear mac address-table", "configure terminal"]
    },
    {
      "id": "cdp_neighbors",
      "prompt": "See which neighbors this switch is connected to over CDP.",
      "device": "C9300-24P (IOS-XE access switch)",
      "accept": ["show cdp neighbors", "show cdp neighbors detail"],
      "reject": ["cdp run", "no cdp enable"]
    },
    {
      "id": "interface_errors",
      "prompt": "Find interfaces that have input or output errors.",
      "device": "C9300-24P (IOS-XE access switch)",
      "accept": [
        "show interfaces counters errors",
        "show interfaces | include errors",
        "show interfaces status err-disabled"
      ],
      "reject": ["clear counters", "configure terminal"]
    },
    {
      "id": "default_gateway",
      "prompt": "What default gateway is configured on this switch?",
      "device": "C9300-24P (IOS-XE L3-capable switch)",
      "accept": ["show ip route | include 0.0.0.0", "show ip route 0.0.0.0", "show running-config | include ip default-gateway", "show running-config | include gateway"],
      "reject": ["ip default-gateway", "configure terminal"]
    },
    {
      "id": "ospf_neighbors",
      "prompt": "Verify OSPF neighbors are up and in Full state.",
      "device": "C9300-24P (IOS-XE with OSPF)",
      "accept": ["show ip ospf neighbor", "show ip ospf neighbor detail"],
      "reject": ["router ospf", "configure terminal", "clear ip ospf"]
    },
    {
      "id": "cpu_memory",
      "prompt": "Check CPU and memory utilization on the switch.",
      "device": "C9300-24P (IOS-XE access switch)",
      "accept": [
        "show processes cpu sorted",
        "show processes cpu",
        "show memory statistics",
        "show platform software status control-processor brief"
      ],
      "reject": ["reload", "write erase"]
    },
    {
      "id": "ntp_status",
      "prompt": "Confirm NTP is synchronized and show the current time source.",
      "device": "C9300-24P (IOS-XE access switch)",
      "accept": ["show ntp status", "show ntp associations", "show clock"],
      "reject": ["ntp server", "configure terminal"]
    },
    {
      "id": "po_status",
      "prompt": "Show port-channel / EtherChannel summary and member link status.",
      "device": "C9300-24P (IOS-XE access switch)",
      "accept": ["show etherchannel summary", "show interfaces port-channel", "show etherchannel detail"],
      "reject": ["channel-group", "configure terminal"]
    },
    {
      "id": "acl_hit_count",
      "prompt": "List IP access lists configured on the device without entering config mode.",
      "device": "C9300-24P (IOS-XE access switch)",
      "accept": ["show ip access-lists", "show access-lists", "show run | include access-list"],
      "reject": ["ip access-list", "configure terminal"]
    },
    {
      "id": "ssh_users",
      "prompt": "See who is logged in via SSH or console right now.",
      "device": "C9300-24P (IOS-XE access switch)",
      "accept": ["show users", "show line", "show session"],
      "reject": ["clear line", "configure terminal"]
    }
  ],
  "control_reference": {
    "author": "Cursor agent (control group — no Ollama, no tool execution)",
    "answers": {
      "vlan_99_status": "show vlan brief | include 99",
      "list_access_ports": "show interfaces status",
      "mac_vlan10": "show mac address-table vlan 10",
      "cdp_neighbors": "show cdp neighbors detail",
      "interface_errors": "show interfaces counters errors",
      "default_gateway": "show ip route | include 0.0.0.0",
      "ospf_neighbors": "show ip ospf neighbor",
      "cpu_memory": "show processes cpu sorted\nshow memory statistics",
      "ntp_status": "show ntp status",
      "po_status": "show etherchannel summary",
      "acl_hit_count": "show ip access-lists",
      "ssh_users": "show users"
    }
  }
}
