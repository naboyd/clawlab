[Unit]
Description=ISC DHCP sidecar (include-file API + local Web UI)
After=network-online.target isc-dhcp-server.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/clawlab/dhcp-sidecar
EnvironmentFile=-/etc/dhcp-sidecar/env
Environment=DHCP_SIDECAR_HOST=127.0.0.1
Environment=DHCP_SIDECAR_PORT=9080
Environment=DHCP_INCLUDES_DIR=/etc/dhcp/dhcpd.d
Environment=DHCP_SIDECAR_STATE_DIR=/var/lib/dhcp-sidecar
ExecStart=/opt/clawlab/dhcp-sidecar/venv/bin/python /opt/clawlab/dhcp-sidecar/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/dhcp/dhcpd.d /var/lib/dhcp-sidecar
PrivateTmp=true

[Install]
WantedBy=multi-user.target
