// ---------------------------------------------------------------------------
// OpenClaw model tiering: local Ollama for routine work, Claude for hard work.
// Merge into ~/.openclaw/openclaw.json (JSON — strip // comments) or apply the
// equivalent openclaw config set / openclaw models set commands (see MODELS.md).
// ---------------------------------------------------------------------------
{
  models: {
    providers: {
      // Local Ollama. IMPORTANT: native API, NOT the /v1 path (/v1 breaks tool
      // calling). Local host needs no real key — "ollama-local" is the marker.
      ollama: {
        api: "ollama",
        baseUrl: "http://127.0.0.1:11434",
        apiKey: "ollama-local",
      },
      // Claude API. Key stays in ~/.openclaw/.env as ANTHROPIC_API_KEY.
      anthropic: {
        apiKeyEnv: "ANTHROPIC_API_KEY",
      },
    },
  },
  agents: {
    defaults: {
      // Tier 1 default: local 8B for routine work. fallbacks = escalate to
      // Claude if Ollama is down.
      model: {
        primary: "ollama/llama3.1:8b",
        fallbacks: ["anthropic/claude-sonnet-5"],
      },
    },
    // Tier 2: agents that need reasoning are pinned to Claude (strict).
    list: [
      {
        name: "deep-analysis",
        model: {
          primary: "anthropic/claude-opus-4-8",
          fallbacks: [],
        },
      },
    ],
  },
}
