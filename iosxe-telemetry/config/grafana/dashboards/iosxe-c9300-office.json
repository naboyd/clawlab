{
  "uid": "iosxe-c9300-office",
  "title": "IOS-XE MDT \u2014 Catalyst Office",
  "tags": [
    "clawlab",
    "iosxe",
    "mdt",
    "catalyst"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Switch",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-iosxe"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"iosxe_telemetry\", tag: \"source\", start: -7d)",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "C9300-24-Office",
          "value": "C9300-24-Office"
        }
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-iosxe"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"iosxe_telemetry\", tag: \"name\", predicate: (r) => r.subscription == \"603\" and r.source == \"${source}\", start: -7d)",
        "refresh": 1,
        "sort": 1,
        "regex": "/^(GigabitEthernet|TenGigabitEthernet|FortyGigabitEthernet|Te|Gi).+/",
        "current": {
          "text": "GigabitEthernet1/0/1",
          "value": "GigabitEthernet1/0/1"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "CPU (5s avg)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-iosxe"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-iosxe"
          },
          "query": "from(bucket: \"iosxe_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.source == \"${source}\" and r.subscription == \"601\" and r._field == \"five_seconds\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Memory used",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-iosxe"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-iosxe"
          },
          "query": "from(bucket: \"iosxe_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.source == \"${source}\" and r.subscription == \"602\" and r.name == \"Processor\")\n  |> filter(fn: (r) => r._field == \"used_memory\" or r._field == \"total_memory\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({ _time: r._time, _value: float(v: r.used_memory) / float(v: r.total_memory) * 100.0 }))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
