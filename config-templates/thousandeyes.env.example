# Cisco ThousandEyes API token for OpenClaw MCP (mcp.servers.thousandeyes).
# Copy to ~/.clawlab/thousandeyes/env and chmod 600.
#
# Create at: ThousandEyes → Account Settings → Users & Roles → your user → Edit
# Required permission: API Access
#
# Never commit the real token.

THOUSANDEYES_API_TOKEN=
