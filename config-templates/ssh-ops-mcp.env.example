# ssh_ops_mcp/data/.env  — Fernet-encrypted secrets store is generated at runtime.
# master.key is created on first run and MUST stay out of git.
#
# Server-side shared bearer(s) for the identity proxy → raw MCP (:8766).
# Rotated via MCP Admin GUI; used by sync-openclaw-gateway-mcp-auth.sh for OpenClaw.
# External clients (Cursor, Claude Desktop) MUST use PATs (skops_…) via portal MCP tokens
# on the identity proxy (:8767), not this shared token.
MCP_TOKEN__current=REPLACE_OR_ROTATE_VIA_GUI
SSH_OPS_MCP_TRANSPORT=streamable-http
SSH_OPS_MCP_PORT=8766
SSH_OPS_MCP_TLS_CERT=/certs/lab.example.com.crt
SSH_OPS_MCP_TLS_KEY=/certs/lab.example.com.key
# Role-based access control (requires claw-auth users.db mounted read-only)
CLAW_AUTH_DB=/claw-auth/users.db
SSH_OPS_RBAC=1
