# IOS-XE TIG stack secrets (Telegraf + InfluxDB + Grafana).
# Installed to ~/.clawlab/telemetry/env by install-iosxe-telemetry-stack.sh
# Never commit the real file.

# InfluxDB 2.x (auto-created on first stack start)
INFLUX_ORG=clawlab
INFLUX_BUCKET=iosxe_telemetry
INFLUX_TOKEN=
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=

# Grafana (local UI on 127.0.0.1:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Telegraf MDT listener publish (host:host:container)
TELEMETRY_MDT_PUBLISH=0.0.0.0:57000:57000

# Grafana — set by sync-iosxe-telemetry-grafana-portal.sh from portal config
TELEMETRY_GRAFANA_PUBLISH=
GRAFANA_ROOT_URL=
GRAFANA_PROXY_URL=http://127.0.0.1:3000

# Container images (pin updates deliberately)
INFLUX_IMAGE=docker.io/library/influxdb:2.7-alpine
TELEGRAF_IMAGE=docker.io/library/telegraf:1.32-alpine
GRAFANA_IMAGE=docker.io/grafana/grafana:11.4.0
