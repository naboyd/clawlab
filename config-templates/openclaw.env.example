# ~/.openclaw/.env  (referenced by openclaw.json apiKey/password ENV-VAR NAMES)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OLLAMA_API_KEY=ollama            # any non-empty value; local ollama ignores it
OPENCLAW_GATEWAY_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_STRING
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_A_LONG_RANDOM_STRING
